<Window x:Class="NightClubPatcher.Gui.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced - NCMK" Width="1000" Height="700" Style="{StaticResource NcmkWindow}">
  <TabControl Margin="10" Background="{StaticResource Panel}">
    <TabItem Header="APK Explorer">
      <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Original backup" Click="OpenBackup_Click" Margin="0,0,6,0"/>
          <Button Content="Patched current" Click="OpenPatched_Click" Margin="0,0,6,0"/>
          <Button Content="Open APK..." Click="OpenApk_Click" Margin="0,0,6,0"/>
          <TextBlock x:Name="ApkPathText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Width="230" Margin="8,0,0,0">
          <Button Content="Extract" Click="Extract_Click"/>
          <Button Content="Replace (new signed copy)" Click="Replace_Click"/>
          <Button Content="Export APK" Click="Export_Click"/>
          <Button Content="Hash (SHA-256)" Click="Hash_Click"/>
          <Button Content="View info" Click="Info_Click"/>
          <TextBox x:Name="EntryInfo" Margin="0,8,0,0" Height="300" IsReadOnly="True" TextWrapping="Wrap"
                   Background="#0E0C14" Foreground="#CFC8E3" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <TreeView x:Name="ApkTree" Background="#0E0C14" Foreground="{StaticResource Fg}"/>
      </DockPanel>
    </TabItem>

    <TabItem Header="Unity / IL2CPP">
      <TextBox x:Name="UnityInfo" Margin="10" IsReadOnly="True" FontFamily="Consolas" Background="#0E0C14"
               Foreground="#CFC8E3" VerticalScrollBarVisibility="Auto"/>
    </TabItem>

    <TabItem Header="Builds &amp; Recovery">
      <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
        <CheckBox x:Name="AllowUnverified" Content="Allow unverified build (unknown version / fingerprints not pinned)"
                  Foreground="{StaticResource Fg}" Margin="0,4" Checked="Options_Changed" Unchecked="Options_Changed"/>
        <CheckBox x:Name="EmbedMods" Content="Embed libncmkmod_*.so from Native/out into the APK" IsChecked="True"
                  Foreground="{StaticResource Fg}" Margin="0,4,0,12" Checked="Options_Changed" Unchecked="Options_Changed"/>
        <Button Content="Pin fingerprints from original backup" Click="Pin_Click"/>
        <Button Content="Install patched-current.apk" Click="InstallCurrent_Click"/>
        <Button Content="Restore previous modded build (patched-previous.apk)" Click="InstallPrevious_Click"/>
        <Button Content="Import original APK from file..." Click="Import_Click"/>
        <Button Content="Push mods + config to headset (DeviceMods -> NCMKMods)" Click="PushMods_Click"/>
        <Button Content="Open DeviceMods folder" Click="OpenDeviceMods_Click"/>
        <Button Content="Disable Safe Mode" Click="SafeOff_Click"/>
        <Button Content="Launch game" Click="Launch_Click"/>
        <Button Content="Open Backups folder" Click="OpenBackups_Click"/>
        <Button Content="Open Builds folder" Click="OpenBuilds_Click"/>
      </StackPanel>
    </TabItem>

    <TabItem Header="Tools">
      <TextBox x:Name="ToolsInfo" Margin="10" IsReadOnly="True" FontFamily="Consolas" Background="#0E0C14"
               Foreground="#CFC8E3"/>
    </TabItem>
  </TabControl>
</Window>
