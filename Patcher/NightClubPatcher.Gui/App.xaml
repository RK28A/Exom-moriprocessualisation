<Application x:Class="NightClubPatcher.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#16131F"/>
    <SolidColorBrush x:Key="Panel" Color="#211C2E"/>
    <SolidColorBrush x:Key="Fg" Color="#ECE8F5"/>
    <SolidColorBrush x:Key="Muted" Color="#9D95B3"/>
    <SolidColorBrush x:Key="Accent" Color="#B65CFF"/>
    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Ok" Color="#3DD68C"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="#2E2741"/>
      <Setter Property="BorderBrush" Value="#3E3557"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#7B2FD0"/>
      <Setter Property="BorderBrush" Value="#B65CFF"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="Recovery" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1F4D3A"/>
      <Setter Property="BorderBrush" Value="#3DD68C"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#5A1E22"/>
      <Setter Property="BorderBrush" Value="#E5484D"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Application.Resources>
</Application>
