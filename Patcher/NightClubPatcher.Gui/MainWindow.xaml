<Window x:Class="NightClubPatcher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NCMK - NightClub Simulator Mod Kit" Width="1280" Height="840" MinWidth="1000" MinHeight="680"
        Style="{StaticResource NcmkWindow}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===================== Header ===================== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="AdbPill" CornerRadius="14" Padding="12,6" Background="{StaticResource PanelHi}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="AdbDot" Width="10" Height="10" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="AdbText" Text="ADB: checking..." Foreground="{StaticResource Fg}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Button Style="{StaticResource Small}" Content="Restart ADB" Click="RestartAdb_Click" ToolTip="adb kill-server + start-server"/>
        <Button x:Name="InstallToolsButton" Style="{StaticResource Small}" Content="Install / Repair Tools" Click="InstallTools_Click"
                Visibility="Collapsed" BorderBrush="{StaticResource Warn}"
                ToolTip="Download adb, zipalign, apksigner and Java into Tools/"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryGradient}" Margin="0,0,14,0">
          <TextBlock Text="NCMK" Foreground="White" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock Foreground="{StaticResource Fg}" FontSize="22" FontWeight="Bold">
            <Run Text="NCMK"/>
            <Run Text="NightClub Simulator Mod Kit" Foreground="{StaticResource Accent}"/>
          </TextBlock>
          <TextBlock x:Name="SubtitleText" Text="Patcher and modding API - com.mandegames.NightClubSimulater" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- ===================== Banner (missing tools / warnings) ===================== -->
    <Border Grid.Row="1" x:Name="Banner" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
            Background="#2E2412" BorderBrush="{StaticResource Warn}" BorderThickness="1">
      <TextBlock x:Name="BannerText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
    </Border>

    <!-- ===================== Body ===================== -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Status cards -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="SETUP"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="ADB"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupAdb" Text="..." FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Build Tools"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupBuildTools" Text="..." FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="JDK 17"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupJdk" Text="..." FontWeight="SemiBold"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Android NDK"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupNdk" Text="..." FontWeight="SemiBold"/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="CMake"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupCMake" Text="..." FontWeight="SemiBold"/>
                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Ninja"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupNinja" Text="..." FontWeight="SemiBold"/>
                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Native Loader"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" x:Name="SetupLoader" Text="..." FontWeight="SemiBold"/>
              </Grid>
              <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button x:Name="InstallRepairButton" Content="Install / Repair Tools" Click="InstallTools_Click" Margin="0,0,6,0"
                        ToolTip="Download every missing tool into Tools\ (portable, PATH untouched)"/>
                <Button x:Name="BuildNativeButton" Content="Build Native Loader" Click="BuildNative_Click" Margin="0"
                        ToolTip="Build libncmkloader.so with the bundled NDK, CMake and Ninja"/>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="↻" Padding="8,2" Click="Refresh_Click" ToolTip="Rescan"/>
                <TextBlock Style="{StaticResource CardTitle}" Text="HEADSET"/>
              </DockPanel>
              <ComboBox x:Name="DeviceCombo" Margin="0,4,0,8" SelectionChanged="DeviceCombo_SelectionChanged"
                        ToolTip="Headset used for backup, patch and install"/>
              <TextBlock x:Name="HeadsetText" Style="{StaticResource Big}" Text="..."/>
              <TextBlock x:Name="QuestText" Style="{StaticResource Value}" Foreground="{StaticResource Muted}" Text="..."/>
              <TextBlock x:Name="AuthText" Style="{StaticResource Value}" Text="Authorization: ..."/>
              <Border Style="{StaticResource Chip}">
                <TextBlock x:Name="HeadsetCompatText" Text="-" Foreground="{StaticResource Muted}" FontSize="12"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="NIGHTCLUB SIMULATOR"/>
              <TextBlock x:Name="GameText" Style="{StaticResource Big}" Text="..."/>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Package"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Value}" x:Name="PackageText" Text="com.mandegames.NightClubSimulater" FontSize="11"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Version"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="VersionText" Text="..."/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Version Code"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="VersionCodeText" Text="..."/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Installation"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" x:Name="InstallText" Text="..."/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Loader"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" x:Name="LoaderText" Text="..."/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="ENGINE"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Unity"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Value}" x:Name="UnityText" Text="..."/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Architecture"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="ArchText" Text="..."/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Backend"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="BackendText" Text="..."/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="XR"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" x:Name="XrText" Text="..."/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Build"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" x:Name="CompatText" Text="..."/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="BACKUP &amp; BUILDS"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Original"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Value}" x:Name="BackupText" Text="..."/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Patched"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="BuildsText" Text="..."/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Safe Mode"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="SafeModeText" Text="..."/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="WarningCard" Style="{StaticResource Card}" BorderBrush="{StaticResource Warn}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="WARNINGS" Foreground="{StaticResource Warn}"/>
              <TextBlock x:Name="WarningText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Actions + activity -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Actions" Grid.Row="0">
          <UniformGrid Columns="3">
            <Button x:Name="PatchInstallButton" Style="{StaticResource Primary}" Click="PatchInstall_Click" ToolTip="Choose headset, patch, sign, install">
              <StackPanel>
                <TextBlock Text="Patch + Install" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="recommended" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="PatchButton" Style="{StaticResource Primary}" Click="Patch_Click" Background="#3A2560" ToolTip="Build the patched APK only">
              <StackPanel>
                <TextBlock Text="Patch Game" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="build APK only" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Recovery}" Click="Restore_Click" Margin="0,0,0,8" ToolTip="Reinstall the clean original game">
              <StackPanel>
                <TextBlock Text="Restore Original" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="safest recovery" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <WrapPanel Margin="0,2,0,6">
            <Button Content="Detect / Refresh" Click="Refresh_Click" ToolTip="Re-detect ADB, headset, game and backup"/>
            <Button Content="Backup Original" Click="Backup_Click"/>
            <Button Content="Unpatch" Click="Unpatch_Click"/>
            <Button Content="Start Safe Mode" Click="SafeMode_Click"/>
            <Button Content="Diagnose" Click="Diagnose_Click"/>
            <Button Content="Open Logs" Click="OpenLogs_Click"/>
            <Button Content="Open Logcat" Click="Logcat_Click"/>
            <Button Content="Advanced" Click="Advanced_Click"/>
            <Button Style="{StaticResource DangerButton}" Content="Emergency Restore" Click="Emergency_Click"/>
          </WrapPanel>
          <WrapPanel Margin="2,0,0,12" VerticalAlignment="Center">
            <CheckBox x:Name="LaunchAfterInstall" Content="Launch the game after install" IsChecked="True" VerticalAlignment="Center"
                      Checked="LaunchAfterInstall_Changed" Unchecked="LaunchAfterInstall_Changed"/>
          </WrapPanel>
        </StackPanel>

        <!-- Activity: steps + live log -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="16,12,16,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox x:Name="LogFilter" Width="150" SelectedIndex="0" SelectionChanged="LogFilter_Changed">
                  <ComboBoxItem Content="All messages"/>
                  <ComboBoxItem Content="Steps + results"/>
                  <ComboBoxItem Content="Warnings + errors"/>
                </ComboBox>
                <CheckBox x:Name="AutoScroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Style="{StaticResource Small}" Content="Copy" Click="CopyLog_Click"/>
                <Button Style="{StaticResource Small}" Content="Save..." Click="SaveLog_Click"/>
                <Button Style="{StaticResource Small}" Content="Clear" Click="ClearLog_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ACTIVITY" Style="{StaticResource CardTitle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActivityTitle" Text="Idle" Foreground="{StaticResource Fg}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ActivityTime" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
            <ProgressBar Grid.Row="1" x:Name="Progress" Height="3" IsIndeterminate="False" Value="0" Margin="16,0,16,8"
                         Foreground="{StaticResource Accent}" Background="{StaticResource PanelHi}" BorderThickness="0"/>
            <Grid Grid.Row="2" Margin="16,0,16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border CornerRadius="8" Background="#120F1B" Padding="10">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="STEPS" Style="{StaticResource CardTitle}"/>
                  <ItemsControl x:Name="StepsList">
                    <ItemsControl.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,3">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding Brush}" Width="20" FontWeight="Bold"/>
                          <TextBlock Text="{Binding Title}" Foreground="{Binding TextBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>
              <ListBox Grid.Column="2" x:Name="LogList" Background="#0B0911" BorderThickness="0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,1"/>
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="#6E6688" Margin="0,0,8,0"/>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding Brush}" Width="16"/>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontWeight="{Binding Weight}"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== Status bar ===================== -->
    <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,7" CornerRadius="8" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" x:Name="StatusRight" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="Status:" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
        <TextBlock x:Name="StatusText" Text="Starting..." Foreground="{StaticResource Fg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
