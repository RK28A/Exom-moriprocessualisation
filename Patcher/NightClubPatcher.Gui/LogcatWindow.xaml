<Window x:Class="NightClubPatcher.Gui.LogcatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logcat - NCMK / Unity / libil2cpp / crashes" Width="1000" Height="640"
        Background="{StaticResource Bg}">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Start" Click="Start_Click" Width="90" Margin="0,0,6,0"/>
      <Button Content="Stop" Click="Stop_Click" Width="90" Margin="0,0,6,0"/>
      <Button Content="Clear device log + Start" Click="ClearStart_Click" Margin="0,0,6,0"/>
      <Button Content="Save..." Click="Save_Click" Width="90" Margin="0,0,6,0"/>
      <CheckBox x:Name="LoaderOnly" Content="NCMK only" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
      <TextBlock x:Name="StatusText" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0"/>
    </StackPanel>
    <TextBox x:Name="Output" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0E0C14"
             Foreground="#CFC8E3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
