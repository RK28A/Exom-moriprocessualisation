<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NightClubPatcher</AssemblyName>
    <RootNamespace>NightClubPatcher.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NightClubPatcher.Core\NightClubPatcher.Core.csproj" />
  </ItemGroup>
  <!-- Ship version profiles (and the native payload when it has been built) next to the executable. -->
  <ItemGroup>
    <None Include="..\..\Versions\*.json" Link="Versions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Native\out\arm64-v8a\*.so" Link="Payload\arm64-v8a\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
